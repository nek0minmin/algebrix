# Algebrix AI proxy secrets.
#
# These are NOT bundled with the app and must never be committed. They are set
# once against the Supabase project and read by the ai-proxy Edge Function:
#
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GROQ_API_KEY=...
#   supabase secrets set NVIDIA_API_KEY=...
#
# For local development only, `supabase functions serve` reads this file when
# copied to `.env` in the same directory.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
